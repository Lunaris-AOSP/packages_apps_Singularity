<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/edgego_guide_preview_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceLarge" />

    <TextView
        android:id="@+id/edgego_guide_preview_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="?android:attr/textAppearanceSmall" />

    <FrameLayout
        android:id="@+id/edgego_guide_preview_host"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/edgego_guide_preview_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:text="@string/edgego_guide_preview_hint"
        android:textAppearance="?android:attr/textAppearanceSmall" />

    <Button
        android:id="@+id/edgego_guide_preview_replay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/edgego_guide_replay"
        android:textAllCaps="false" />
</LinearLayout>
