<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    xmlns:lineage="http://schemas.android.com/apk/res-auto"
    android:title="@string/status_bar_title" >

    <!-- Status bar icons customizations -->
    <PreferenceCategory
        android:title="@string/status_bar_icons_category_title">

        <Preference
            android:key="status_bar_icons"
            android:title="@string/status_bar_icons_title"
            android:summary="@string/status_bar_icons_summary">
                <intent android:action="com.android.settings.action.STATUS_BAR_TUNER" />
        </Preference>

        <lineageos.preference.LineageSystemSettingListPreference
            android:key="status_bar_clock"
            android:title="@string/status_bar_clock_position_title"
            android:summary="%s"
            android:dialogTitle="@string/status_bar_clock_position_title"
            android:entries="@array/status_bar_clock_position_entries"
            android:entryValues="@array/status_bar_clock_position_values"
            android:defaultValue="0" />

        <Preference
            android:key="statusbar_clock_chip"
            android:title="@string/statusbar_clock_chip_title"
            android:summary="@string/statusbar_clock_chip_summary"
            android:fragment="org.lunaris.settings.fragments.statusbar.ClockChipSettings" />

        <Preference
            android:key="cutout_progress"
            android:title="@string/cutout_progress_title"
            android:summary="@string/cutout_progress_summary"
            android:fragment="org.lunaris.settings.fragments.statusbar.CutoutProgressSettingsFragment" />

        <Preference
            android:key="clock"
            android:title="@string/status_bar_clock_title"
            android:summary="@string/status_bar_clock_summary"
            android:fragment="org.lunaris.settings.fragments.statusbar.Clock" />

        <org.lunaris.settings.preferences.SystemSettingSwitchPreference
            android:key="bluetooth_show_battery"
            android:title="@string/bluetooth_battery_title"
            android:summary="@string/bluetooth_battery_summary"
            android:defaultValue="true"/>

        <org.lunaris.settings.preferences.SystemSettingSwitchPreference
            android:key="statusbar_colored_icons"
            android:title="@string/statusbar_colored_icons_title"
            android:summary="@string/statusbar_colored_icons_summary"
            android:defaultValue="false" />

        <org.lunaris.settings.preferences.SystemSettingSwitchPreference
	        android:key="statusbar_notif_count"
	        android:title="@string/statusbar_notif_count_title"
	        android:summary="@string/statusbar_notif_count_summary"
	        android:defaultValue="false" />

        <org.lunaris.settings.preferences.SystemSettingSwitchPreference
            android:key="wifi_standard_icon"
            android:title="@string/wifi_standard_icon_title"
            android:summary="@string/wifi_standard_icon_summary"
            android:defaultValue="false"/>
        
        <org.lunaris.settings.preferences.SystemSettingSwitchPreference
            android:key="tint_statusbar_icons_with_accent"
            android:title="@string/status_bar_tint_icons_title"
            android:summary="@string/status_bar_tint_icons_summary"
            android:defaultValue="false" />

        <Preference
            android:key="ongoing_progress_settings"
            android:title="@string/ongoing_progress_settings_title"
            android:summary="@string/ongoing_progress_settings_summary"
            android:fragment="org.lunaris.settings.fragments.statusbar.OngoingProgressBar" />
            
    </PreferenceCategory>

    <!-- Custom logo -->
    <PreferenceCategory
        android:title="@string/status_bar_logo_title" >

        <org.lunaris.settings.preferences.SystemSettingSwitchPreference
                android:key="status_bar_logo"
                android:title="@string/status_bar_logo_title"
                android:summary="@string/status_bar_logo_summary"
                android:defaultValue="false" />

            <!-- Logo position -->
            <org.lunaris.settings.preferences.SystemSettingListPreference
                android:key="status_bar_logo_position"
                android:title="@string/status_bar_logo_position_title"
                android:entries="@array/status_bar_logo_position_entries"
                android:entryValues="@array/status_bar_logo_position_values"
                android:defaultValue="0"
                android:dependency="status_bar_logo" />

            <!-- Logo style -->
            <org.lunaris.settings.preferences.StatusBarLogoStylePreference
                android:key="status_bar_logo_style"
                android:title="@string/status_bar_logo_style_title"
                android:summary="@string/status_bar_logo_style_summary"
                android:dependency="status_bar_logo" />

            <!-- Logo color type -->
            <org.lunaris.settings.preferences.SystemSettingListPreference
                android:key="status_bar_logo_color"
                android:title="@string/status_bar_logo_color_title"
                android:entries="@array/status_bar_logo_color_entries"
                android:entryValues="@array/status_bar_logo_color_values"
                android:dependency="status_bar_logo"
                android:defaultValue="0" />
               
            <!-- Logo custom color -->
            <org.lunaris.settings.preferences.colorpicker.ColorPickerPreference
                android:key="status_bar_logo_color_picker"
                android:title="@string/status_bar_logo_color_custom"
                android:dependency="status_bar_logo"
                settings:defaultValue="0xFFFFFFFF" />

    </PreferenceCategory>

    <!-- Status bar battery customizations -->
    <PreferenceCategory
        android:title="@string/status_bar_battery_category_title" >

        <lineageos.preference.LineageSystemSettingListPreference
            android:key="status_bar_battery_style"
            android:title="@string/status_bar_battery_style_title"
            android:entries="@array/status_bar_battery_style_entries"
            android:entryValues="@array/status_bar_battery_style_values"
            android:defaultValue="0" />

        <lineageos.preference.LineageSystemSettingListPreference
            android:key="status_bar_show_battery_percent"
            android:title="@string/status_bar_battery_percent_title"
            android:entries="@array/status_bar_battery_percent_entries"
            android:entryValues="@array/status_bar_battery_percent_values"
            android:defaultValue="0" />

        <Preference
            android:key="batterybar"
            android:title="@string/battery_bar_title"
            android:summary="@string/battery_bar_summary"
            android:fragment="org.lunaris.settings.fragments.statusbar.BatteryBar" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/gestures_title">

        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="double_tap_sleep_gesture"
            android:title="@string/statusbar_doubletap_sleep_title"
            android:summary="@string/statusbar_doubletap_sleep_summary"
            android:defaultValue="true" />

        <lineageos.preference.LineageSystemSettingListPreference
            android:key="qs_quick_pulldown"
            android:title="@string/status_bar_quick_qs_pulldown_title"
            android:entries="@array/status_bar_quick_qs_pulldown_entries"
            android:entryValues="@array/status_bar_quick_qs_pulldown_values"
            android:defaultValue="0" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/statusbar_extra_padding_category">

        <org.lunaris.settings.preferences.SystemSettingSeekBarPreference
            android:key="statusbar_extra_padding_start"
            android:title="@string/statusbar_extra_padding_start_title"
            android:defaultValue="0"
            settings:interval="1"
            settings:units="@string/unit_pixels"
            android:max="30"
            settings:min="-30" />

        <org.lunaris.settings.preferences.SystemSettingSeekBarPreference
            android:key="statusbar_extra_padding_top"
            android:title="@string/statusbar_extra_padding_top_title"
            android:defaultValue="0"
            settings:interval="1"
            settings:units="@string/unit_pixels"
            android:max="30"
            settings:min="-30" />

        <org.lunaris.settings.preferences.SystemSettingSeekBarPreference
            android:key="statusbar_extra_padding_end"
            android:title="@string/statusbar_extra_padding_end_title"
            android:defaultValue="0"
            settings:interval="1"
            settings:units="@string/unit_pixels"
            android:max="30"
            settings:min="-30" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/statusbar_privacy_indicators_category">

        <org.lunaris.settings.preferences.SecureSettingSwitchPreference
            android:key="enable_location_privacy_indicator"
            android:title="@string/location_privacy_indicator_title"
            android:summary="@string/location_privacy_indicator_summary"
            android:defaultValue="true" />

        <org.lunaris.settings.preferences.SecureSettingSwitchPreference
            android:key="enable_projection_privacy_indicator"
            android:title="@string/projection_privacy_indicator_title"
            android:summary="@string/projection_privacy_indicator_summary"
            android:defaultValue="true" />

        <org.lunaris.settings.preferences.SecureSettingSwitchPreference
            android:key="enable_camera_privacy_indicator"
            android:title="@string/mic_camera_privacy_indicator_title"
            android:summary="@string/mic_camera_privacy_indicator_summary"
            android:defaultValue="true" />

    </PreferenceCategory>

</PreferenceScreen>
