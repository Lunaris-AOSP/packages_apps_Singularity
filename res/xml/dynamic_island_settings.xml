<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/lunaris_bar_title">

    <SwitchPreferenceCompat
        android:key="status_bar_show_dynamic_island"
        android:title="@string/lunaris_bar_status_bar_show_dynamic_island"
        android:persistent="false" />

    <PreferenceCategory
        android:key="customize"
        android:title="@string/lunaris_bar_customize">

        <Preference
            android:key="appearance"
            android:title="@string/lunaris_bar_appearance"
            android:fragment="org.lunaris.settings.fragments.statusbar.DynamicIslandSettings"
            android:summary="@string/lunaris_bar_appearance_description">

            <extra
                android:name="page"
                android:value="appearance" />

        </Preference>

        <Preference
            android:key="colors"
            android:title="@string/lunaris_bar_colors"
            android:fragment="org.lunaris.settings.fragments.statusbar.DynamicIslandSettings"
            android:summary="@string/lunaris_bar_colors_description">

            <extra
                android:name="page"
                android:value="colors" />

        </Preference>

        <Preference
            android:key="motion"
            android:title="@string/lunaris_bar_motion"
            android:fragment="org.lunaris.settings.fragments.statusbar.DynamicIslandSettings"
            android:summary="@string/lunaris_bar_motion_description">

            <extra
                android:name="page"
                android:value="motion" />

        </Preference>

        <Preference
            android:key="media"
            android:title="@string/lunaris_bar_media"
            android:fragment="org.lunaris.settings.fragments.statusbar.DynamicIslandSettings"
            android:summary="@string/lunaris_bar_media_description">

            <extra
                android:name="page"
                android:value="media" />

        </Preference>

        <Preference
            android:key="gestures"
            android:title="@string/lunaris_bar_gestures"
            android:fragment="org.lunaris.settings.fragments.statusbar.DynamicIslandSettings"
            android:summary="@string/lunaris_bar_gestures_description">

            <extra
                android:name="page"
                android:value="gestures" />

        </Preference>

        <Preference
            android:key="cards"
            android:title="@string/lunaris_bar_cards"
            android:fragment="org.lunaris.settings.fragments.statusbar.LunarisBarCardsSettings"
            android:summary="@string/lunaris_bar_cards_description">

            <extra
                android:name="page"
                android:value="cards" />

        </Preference>

        <Preference
            android:key="features"
            android:title="@string/lunaris_bar_features"
            android:fragment="org.lunaris.settings.fragments.statusbar.DynamicIslandSettings"
            android:summary="@string/lunaris_bar_features_description">

            <extra
                android:name="page"
                android:value="features" />

        </Preference>

    </PreferenceCategory>

 <com.android.settingslib.widget.UntitledPreferenceCategory
        android:key="singularity_two_category">

    <Preference
        android:key="reset_all"
        android:title="@string/lunaris_bar_reset_all"
        android:persistent="false" />

</com.android.settingslib.widget.UntitledPreferenceCategory>

</PreferenceScreen>
