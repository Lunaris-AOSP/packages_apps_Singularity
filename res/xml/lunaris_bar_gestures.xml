    android:title="@string/lunaris_bar_gestures">

    <Preference
        android:key="gesture_tap"
        android:title="@string/lunaris_bar_gesture_tap"
        android:persistent="false" />

    <Preference
        android:key="gesture_double_tap"
        android:title="@string/lunaris_bar_gesture_double_tap"
