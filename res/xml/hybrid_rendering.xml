<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/hybrid_rendering_title">

    <lineageos.preference.GlobalSettingMainSwitchPreference
        android:key="hybrid_rendering"
        android:title="@string/hybrid_rendering_enable"
        android:defaultValue="false" />

    <com.android.settingslib.widget.BannerMessagePreference
        android:key="hybrid_rendering_warning"
        android:title="@string/hybrid_rendering_warning_title"
        android:summary="@string/hybrid_rendering_warning_summary"
        settings:attentionLevel="medium"
        settings:searchable="false" />

    <org.lunaris.settings.preferences.GlobalSettingSwitchPreference
        android:key="hybrid_rendering_systemui"
        android:title="@string/hybrid_rendering_systemui"
        android:summary="@string/hybrid_rendering_systemui_summary"
        android:defaultValue="false"
        android:dependency="hybrid_rendering" />

    <org.lunaris.settings.preferences.GlobalSettingSwitchPreference
        android:key="hybrid_rendering_launcher"
        android:title="@string/hybrid_rendering_launcher"
        android:defaultValue="false"
        android:dependency="hybrid_rendering" />

    <Preference
        android:key="hybrid_rendering_apps"
        android:title="@string/hybrid_rendering_apps"
        android:summary="@string/hybrid_rendering_apps_summary"
        android:persistent="false"
        android:dependency="hybrid_rendering" />

    <com.android.settingslib.widget.FooterPreference
        android:key="hybrid_rendering_footer"
        android:title="@string/hybrid_rendering_footer"
        android:selectable="false" />
</PreferenceScreen>
