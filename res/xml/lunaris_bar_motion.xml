<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/lunaris_bar_motion">

    <ListPreference
        android:key="animation_style"
        android:title="@string/lunaris_bar_animation_style"
        android:persistent="false" />

    <org.lunaris.settings.preferences.LunarisBarSeekBarPreference
        android:key="animation_speed"
        android:title="@string/lunaris_bar_animation_speed"
        android:persistent="false"
        android:defaultValue="100"
        settings:min="50"
        android:max="200"
        settings:interval="1" />

    <ListPreference
        android:key="animation_bounce"
        android:title="@string/lunaris_bar_animation_bounce"
        android:persistent="false" />

    <SwitchPreferenceCompat
        android:key="status_glow"
        android:title="@string/lunaris_bar_status_glow"
        android:persistent="false"
        android:summary="@string/lunaris_bar_status_glow_description" />

    <SwitchPreferenceCompat
        android:key="reduce_motion"
        android:title="@string/lunaris_bar_reduce_motion"
        android:persistent="false" />

    <SwitchPreferenceCompat
        android:key="haptics"
        android:title="@string/lunaris_bar_haptics"
        android:persistent="false" />

    <SwitchPreferenceCompat
        android:key="mini_fade"
        android:title="@string/lunaris_bar_mini_fade"
        android:persistent="false" />

    <PreferenceCategory
        android:key="alternative_versions"
        android:title="@string/lunaris_bar_alternative_versions">

        <SwitchPreferenceCompat
            android:key="status_bar_dynamic_island_alternative_animation"
            android:title="@string/lunaris_bar_status_bar_dynamic_island_alternative_animation"
            android:persistent="false" />

        <SwitchPreferenceCompat
            android:key="status_bar_dynamic_island_alternative_media"
            android:title="@string/lunaris_bar_status_bar_dynamic_island_alternative_media"
            android:persistent="false" />

        <SwitchPreferenceCompat
            android:key="status_bar_dynamic_island_alternative_flashlight"
            android:title="@string/lunaris_bar_status_bar_dynamic_island_alternative_flashlight"
            android:persistent="false" />

    </PreferenceCategory>

</PreferenceScreen>
